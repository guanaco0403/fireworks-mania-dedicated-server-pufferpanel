    "groups": [
        {
            "display": "Game Settings",
            "description": "",
            "variables": [
                "auto-despawn-enabled",
                "enable-destructions",
                "enable-fly-mode",
                "explosion-forces-enabled",
                "ignition-forces-enabled",
                "max-fireworks",
                "max-props",
                "spawn-delay",
                "max-players",
                "server-name",
                "server-description",
                "server-author",
                "server-map",
                "server-mods",
                "locked-items"
            ],
            "order": 1
        },
        {
            "display": "Network Settings",
            "description": "",
            "variables": [
                "who-can-join",
                "server-ip",
                "server-port"
            ],
            "order": 2
        },
        {
            "display": "Advanced Settings",
            "description": "Advanced server release repository & updater configuration",
            "variables": [
                "max-cpu-cores",
                "max-ram-mb",
                "auto-update-on-start",
                "github-repo",
                "server-version",
                "github-token",
                "modio-token"
            ],
            "order": 3
        }
    ],
    "install": [
        {
            "type": "command",
            "commands": [
                "pip install --no-cache-dir requests PyGithub",
                "python3 -c \"import urllib.request, time; urllib.request.urlretrieve(f'https://raw.githubusercontent.com/guanaco0403/fireworks-mania-dedicated-server-pufferpanel/main/ServerAutoUpdate.py?t={int(time.time())}', 'ServerAutoUpdate.py')\"",
                "python3 ServerAutoUpdate.py --token \"${github-token}\" --repo \"${github-repo}\" --version \"${server-version}\""
            ]
        }
    ],
    "uninstall": null,
    "run": {
        "command": "./start.sh",
        "stop": "quit",
        "pre": [
            {
                "type": "writefile",
                "target": "start.sh",
                "text": "#!/bin/sh\nif [ \"${auto-update-on-start}\" = \"true\" ] || [ \"${auto-update-on-start}\" = \"True\" ]; then\n    pip install --no-cache-dir requests PyGithub >/dev/null 2>&1 || true\n    python3 -c \"import urllib.request, time; urllib.request.urlretrieve(f'https://raw.githubusercontent.com/guanaco0403/fireworks-mania-dedicated-server-pufferpanel/main/ServerAutoUpdate.py?t={int(time.time())}', 'ServerAutoUpdate.py')\" || true\n    python3 ServerAutoUpdate.py --token \"${github-token}\" --repo \"${github-repo}\" --version \"${server-version}\" || true\nfi\nchmod +x FireworksManiaDedicatedLinux.x86_64 2>/dev/null || true\n\nif [ \"${max-ram-mb}\" -gt 0 ] 2>/dev/null; then\n    RAM_KB=$((${max-ram-mb} * 1024))\n    ulimit -v $RAM_KB 2>/dev/null || true\nfi\n\nCPU_CMD=\"\"\nif [ \"${max-cpu-cores}\" -gt 0 ] 2>/dev/null; then\n    CORES_END=$((${max-cpu-cores} - 1))\n    if command -v taskset >/dev/null 2>&1; then\n        CPU_CMD=\"taskset -c 0-${CORES_END}\"\n    fi\nfi\n\nexec $CPU_CMD ./FireworksManiaDedicatedLinux.x86_64\n"
            },
            {
                "type": "command",
                "commands": [
                    "chmod +x start.sh"
                ]
            },
            {
                "type": "writefile",
                "target": "host.config",
                "text": "{\n  \"HostConfig\": {\n    \"WhoCanJoin\": ${who-can-join},\n    \"ConnectionType\": 2,\n    \"Name\": \"${server-name}\",\n    \"Description\": \"${server-description}\",\n    \"Author\": \"${server-author}\",\n    \"MaxPlayers\": ${max-players},\n    \"IP\": \"${server-ip}\",\n    \"Port\": ${server-port}\n  },\n  \"GameConfig\": {\n    \"Mods\": ${server-mods},\n    \"Map\": \"${server-map}\",\n    \"LockedInventoryEntityIds\": ${locked-items},\n    \"EnableIgnitionForces\": ${ignition-forces-enabled},\n    \"EnableExplosionPhysicsForces\": ${explosion-forces-enabled},\n    \"EnableAutoDespawnUsedFireworks\": ${auto-despawn-enabled},\n    \"EnableDestructions\": ${enable-destructions},\n    \"EnableFlyMode\": ${enable-fly-mode},\n    \"MaxAllowedPlayerSpawnedFireworks\": ${max-fireworks},\n    \"MaxAllowedPlayerSpawnedProps\": ${max-props},\n    \"MinTimeBetweenPlayerSpawnInSeconds\": ${spawn-delay}\n  }\n}"
            },
            {
                "type": "writefile",
                "text": "${modio-token}",
                "target": "modio.token"
            }
        ],
        "stdin": {
            "type": "stdin"
        },
        "autostart": false,
        "autorecover": false,
        "autorestart": false
    },
    "environment": {
        "type": "docker",
        "image": "python:3.12-slim",
        "containerRoot": "",
        "networkName": "host",
        "bindings": {},
        "portBindings": [
            "${server-port}:${server-port}/udp"
        ]
    },
    "supportedEnvironments": [
        {
            "type": "docker",
            "image": "python:3.12-slim",
            "containerRoot": "",
            "networkName": "host",
            "bindings": {},
            "portBindings": [
                "${server-port}:${server-port}/udp"
            ]
        }
    ],
    "requirements": {},
